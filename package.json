{
  "name": "tmweasy-qr-payment",
  "version": "1.0.0",
  "description": "TypeScript SDK for TMWeasy PromptPay QR Webhook payment API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tmweasy",
    "promptpay",
    "webhook",
    "qr-payment",
    "thai-payment",
    "payment-gateway"
  ],
  "author": "RIIIXCH (https://github.com/riiixch)",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}