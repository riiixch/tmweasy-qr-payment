{
  "name": "@riiixch/tmweasy-qr-payment",
  "version": "1.0.2",
  "description": "TypeScript SDK for TMWeasy PromptPay QR Webhook payment API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tmweasy",
    "promptpay",
    "webhook",
    "qr-payment",
    "thai-payment",
    "payment-gateway"
  ],
  "author": "RIIIXCH",
  "homepage": "https://github.com/riiixch/tmweasy-qr-payment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riiixch/tmweasy-qr-payment.git"
  },
  "bugs": {
    "url": "https://github.com/riiixch/tmweasy-qr-payment/issues"
  },
  "license": "ISC",
  "peerDependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
